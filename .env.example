# Sepolia (source chain)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Creditcoin CC3 testnet
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_CREDITCOIN_RPC=https://rpc.cc3-testnet.creditcoin.network

# Attestcoin proof builder
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1

# Deployed contracts (CC3 + Sepolia, 2026-09-05). The live locker is the
# original lockETH/unlockETH build. quoteLoan + voucher unlock need a
# redeploy of the contracts in this repo.
LOCKER_ADDRESS=0x2bF2EC0ebBa8eFc4999460420a86F1F3c1D0b938
TOXASCORE_ADDRESS=0x2bF2EC0ebBa8eFc4999460420a86F1F3c1D0b938
VITE_LOCKER_ADDRESS=0x2bF2EC0ebBa8eFc4999460420a86F1F3c1D0b938
VITE_TOXASCORE_ADDRESS=0x2bF2EC0ebBa8eFc4999460420a86F1F3c1D0b938

# Worker relayer (Creditcoin testnet key with tCTC for gas)
CREDITCOIN_WALLET_PRIVATE_KEY=

# Collateral release. The locker only honours withdrawals signed by this key,
# and the service signs only when Creditcoin shows no unrepaid loan.
# RELEASER_ADDRESS is read by script/DeployLocker.s.sol at deploy time;
# RELEASER_PRIVATE_KEY is the matching key the prover service signs with.
RELEASER_ADDRESS=0x
RELEASER_PRIVATE_KEY=

# Prover service. Empty means same-origin, which is what `npm run dev` serves.
# Set this when the frontend is deployed away from `npm run prover`.
VITE_PROVER_URL=
PORT=8787
CORS_ORIGIN=*

# Broadcast keys for forge script (never commit)
PRIVATE_KEY=
